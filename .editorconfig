root = true

# Global settings
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Scala files
[*.scala]
indent_size = 2

# sbt build files
[*.sbt]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# IntelliJ IDEA project files (optional, if you want to include them)
[*.iml]
indent_size = 2
