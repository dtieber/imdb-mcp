# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()

# MCP discovery
GET     /mcp/health                 controllers.McpHumanController.health
GET     /mcp/schema                 controllers.McpHumanController.schema

# MCP Resources
GET     /mcp/resources              controllers.McpHumanController.listResources
POST    /mcp/resources/call         controllers.McpHumanController.callResource

